rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidExpense(data) {
      return data.keys().hasAll([
          'amountSen',
          'category',
          'title',
          'occurredAt',
          'createdAt',
          'updatedAt',
          'source'
        ])
        && data.keys().hasOnly([
          'amountSen',
          'category',
          'title',
          'note',
          'occurredAt',
          'createdAt',
          'updatedAt',
          'source'
        ])
        && data.amountSen is int
        && data.amountSen > 0
        && data.amountSen <= 9007199254740991
        && data.category in [
          'food',
          'transport',
          'shopping',
          'entertainment',
          'housing',
          'health',
          'education',
          'other'
        ]
        && data.title is string
        && data.title.size() > 0
        && (!('note' in data) || data.note is string)
        && data.occurredAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.source in ['manual', 'text', 'photo'];
    }

    function isValidIncome(data) {
      return data.keys().hasAll([
          'amountSen', 'category', 'description', 'occurredAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'amountSen', 'category', 'description', 'note', 'occurredAt', 'createdAt', 'updatedAt'
        ])
        && data.amountSen is int
        && data.amountSen > 0
        && data.amountSen <= 9007199254740991
        && data.category in ['salary', 'freelance', 'business', 'investment', 'gift', 'refund', 'other']
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 120
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.occurredAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExercise(data) {
      return data.keys().hasAll([
          'activity',
          'durationSeconds',
          'source',
          'occurredAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'activity',
          'intensity',
          'distanceMetres',
          'durationSeconds',
          'source',
          'occurredAt',
          'createdAt',
          'updatedAt',
          'metricsSource', 'reportedActiveCaloriesKcal', 'reportedTotalCaloriesKcal',
          'reportedAverageHeartRateBpm', 'reportedSteps'
        ])
        && data.activity is string
        && data.activity.size() > 0
        && data.activity.size() <= 80
        && (!('intensity' in data) || data.intensity in ['light', 'moderate', 'vigorous'])
        && data.durationSeconds is int
        && data.durationSeconds > 0
        && data.durationSeconds <= 9007199254740991
        && (!('distanceMetres' in data)
          || (data.distanceMetres is int
            && data.distanceMetres > 0
            && data.distanceMetres <= 9007199254740991))
        && data.source in ['manual', 'text', 'fitness_screenshot']
        && (!data.keys().hasAny(['metricsSource', 'reportedActiveCaloriesKcal',
          'reportedTotalCaloriesKcal', 'reportedAverageHeartRateBpm', 'reportedSteps'])
          || data.source == 'fitness_screenshot')
        && (!('metricsSource' in data) || data.metricsSource in ['Apple Fitness', 'Apple Health', 'Fitness screenshot'])
        && (!('reportedActiveCaloriesKcal' in data) || (data.reportedActiveCaloriesKcal is int
          && data.reportedActiveCaloriesKcal >= 0 && data.reportedActiveCaloriesKcal <= 9007199254740991))
        && (!('reportedTotalCaloriesKcal' in data) || (data.reportedTotalCaloriesKcal is int
          && data.reportedTotalCaloriesKcal >= 0 && data.reportedTotalCaloriesKcal <= 9007199254740991))
        && (!('reportedAverageHeartRateBpm' in data) || (data.reportedAverageHeartRateBpm is int
          && data.reportedAverageHeartRateBpm > 0 && data.reportedAverageHeartRateBpm <= 9007199254740991))
        && (!('reportedSteps' in data) || (data.reportedSteps is int
          && data.reportedSteps >= 0 && data.reportedSteps <= 9007199254740991))
        && data.occurredAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnimeProgress(data, progressId) {
      return data.keys().hasAll([
          'externalId', 'animeId', 'currentEpisode', 'positionSeconds',
          'durationSeconds', 'watchedEpisodes', 'trackingStatus', 'updatedAt', 'title'
        ])
        && data.keys().hasOnly([
          'externalId', 'animeId', 'currentEpisode', 'positionSeconds',
          'durationSeconds', 'watchedEpisodes', 'trackingStatus', 'updatedAt', 'title',
          'coverUrl', 'totalEpisodes'
        ])
        && data.externalId is string
        && data.externalId == progressId
        && data.externalId.size() > 0
        && data.externalId.size() <= 128
        && data.animeId == data.externalId
        && data.currentEpisode is int
        && data.currentEpisode > 0
        // Non-numeric upstream episode labels use a deterministic synthetic
        // number in the 1,000,000+ range so progress can identify them.
        && data.currentEpisode <= 2999999
        && data.positionSeconds is number
        && data.positionSeconds >= 0
        && data.positionSeconds <= 604800
        && data.durationSeconds is number
        && data.durationSeconds >= 0
        && data.durationSeconds <= 604800
        && data.watchedEpisodes is list
        && data.watchedEpisodes.size() <= 1000
        && (data.watchedEpisodes.size() == 0
          || (data.watchedEpisodes[0] is int
            && data.watchedEpisodes[0] > 0
            && data.watchedEpisodes[data.watchedEpisodes.size() - 1] is int
            && data.watchedEpisodes[data.watchedEpisodes.size() - 1] > 0))
        && data.trackingStatus in ['planned', 'watching', 'completed']
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 240
        && (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2048))
        && (!('totalEpisodes' in data) || (data.totalEpisodes is int
          && data.totalEpisodes > 0 && data.totalEpisodes <= 100000));
    }

    match /animes/{animeId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    function isValidFinanceRule(data) {
      return data.keys().hasAll([
          'direction', 'matchType', 'pattern', 'category', 'enabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'direction', 'matchType', 'pattern', 'category', 'enabled', 'createdAt', 'updatedAt'
        ])
        && data.direction in ['expense', 'income']
        && data.matchType in ['exact', 'contains']
        && data.pattern is string
        && data.pattern.size() > 0
        && data.pattern.size() <= 120
        && ((data.direction == 'expense' && data.category in [
          'food', 'transport', 'shopping', 'entertainment', 'housing', 'health', 'education', 'other'
        ]) || (data.direction == 'income' && data.category in [
          'salary', 'freelance', 'business', 'investment', 'gift', 'refund', 'other'
        ]))
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /animeCatalogueStatus/{statusId} {
      allow get: if request.auth != null && statusId == 'current';
      allow list, create, update, delete: if false;
    }

    match /users/{userId}/expenses/{expenseId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidExpense(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidExpense(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/incomes/{incomeId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidIncome(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidIncome(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/exercises/{exerciseId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidExercise(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidExercise(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/settings/preferences {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'bodyWeightKg', 'heightCm', 'monthlyBudgetSen', 'savingsGoalSen', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!('bodyWeightKg' in request.resource.data)
          || (request.resource.data.bodyWeightKg is number
            && request.resource.data.bodyWeightKg >= 20
            && request.resource.data.bodyWeightKg <= 500))
        && (!('heightCm' in request.resource.data)
          || (request.resource.data.heightCm is int
            && request.resource.data.heightCm >= 80
            && request.resource.data.heightCm <= 250))
        && (!('monthlyBudgetSen' in request.resource.data)
          || (request.resource.data.monthlyBudgetSen is int
            && request.resource.data.monthlyBudgetSen > 0
            && request.resource.data.monthlyBudgetSen <= 9007199254740991))
        && (!('savingsGoalSen' in request.resource.data)
          || (request.resource.data.savingsGoalSen is int
            && request.resource.data.savingsGoalSen > 0
            && request.resource.data.savingsGoalSen <= 9007199254740991));
    }

    match /users/{userId}/animeWatchProgress/{progressId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidAnimeProgress(request.resource.data, progressId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/financeRules/{ruleId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidFinanceRule(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidFinanceRule(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
